void main() {
  IO.println("Welcome to Basic Calculator!\n");

  while (true) {

    IO.println("1 - Enter an Equation:\n);
    IO.println("2 - Exit");

    String response = IO.readln("");

    switch (response) {

      case "1" -> {
        String equation = IO.readln("Enter an equation:\n");
        double result = calculation(equation);
        IO.println(String.format("Solution = %.2f", result));
      }
      case "2" -> {
        IO.println("Thank you for using Basic Calculator!");
        return;
      }
      default -> IO.println("Invalid Menu Option");
}
}
}

double calculation(String equation) {
  for (int i = equation.length()-1; i >= 0; i--) {
    char c = equation.charAt(i);
    if (c == '+') {
      return calculation(equation.substring(0, i)) + calculation(equation.substring(i + 1));
    } else if (c == '-') {
      return calculation(equation.substring(0, i)) - calculation(equation.substring(i - 1));
    }
  }

  for (int i = equation.length() - 1; i >= 0; i--) {
    char c = equation.charAt(i);
    if (c == '*') {
      return calculation(equation.substring(0,i)) * calculation(equation.substring(i + 1));
    } else if (c == '/') {
      return calculation(equation.substring(0,i)) / calculation(equation.substring(i + 1));
    }
  }

  for (int i = equation.length() - 1; i >= 0; i--) {
    char c = equation.charAt(i);
    if (c == '^') {
      return Math.pow(calculation(equation.substring(0,i)), calculation(equation.substring(i + 1)));
    }
 }
return Double.parseDouble(equation);
}
